# --- Neon (Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/db?sslmode=require&uselibpqcompat=true

# --- Payload ---
PAYLOAD_SECRET=change-me-langer-zufallsstring
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-Mail (Resend) – Pflicht für echten Versand ---
# 1) Account: https://resend.com
# 2) API Key erstellen → RESEND_API_KEY
# 3) Domain werbeinsel.de bei Resend verifizieren (Domains → Add)
# 4) Dann EMAIL_FROM aus dieser Domain nutzen (nicht onboarding@resend.dev)
RESEND_API_KEY=
EMAIL_FROM=website@werbeinsel.de
EMAIL_TO_AGENTUR=hallo@werbeinsel.de

# --- Storage (Vercel Blob) ---
# Required on Vercel for Media/Kundenlogo uploads (create via Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# --- Spam-Schutz (Cloudflare Turnstile) ---
# Domains: localhost, www.werbeinsel.de, werbeinsel.de, *.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Temporary site gate (coming-soon plakat) ---
# When SITE_PREVIEW_PASSWORD is set, the public site redirects to /coming-soon
# except /admin and /api. Team unlock via "Team-Zugang" on that page.
# Full public launch: SITE_GATE_ENABLED=false
SITE_GATE_ENABLED=true
SITE_PREVIEW_PASSWORD=
# Optional: override cookie token secret (defaults to PAYLOAD_SECRET)
# SITE_GATE_SECRET=


# --- Test- und Prüfseiten (z. B. /test-bloecke) ---
# Lokal (next dev) und in der Vercel-Vorschau automatisch aktiv, in Produktion 404.
# Auf anderen Hosts (z. B. später AWS) für Vorschau-Umgebungen explizit setzen:
# SITE_ENV=preview
