# --- Neon (Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/db?sslmode=require&uselibpqcompat=true

# --- Payload ---
PAYLOAD_SECRET=change-me-langer-zufallsstring
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-Mail (Resend) – Pflicht für echten Versand ---
# 1) Account: https://resend.com
# 2) API Key erstellen → RESEND_API_KEY
# 3) Domain verifizieren ODER zum Testen: EMAIL_FROM=onboarding@resend.dev
#    (dann geht Versand nur an die eigene Resend-Login-Adresse)
RESEND_API_KEY=
EMAIL_FROM=website@werbeinsel.de
EMAIL_TO_AGENTUR=info@werbeinsel.de

# --- Storage (Vercel Blob) ---
# Required on Vercel for Media/Kundenlogo uploads (create via Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# --- Spam-Schutz (Cloudflare Turnstile) ---
# https://dash.cloudflare.com → Turnstile → Add site (Domain: localhost + vercel.app)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
